# cuma WRITEUP.md gabungan di ROOT yang di-ignore (bukan writeup per-soal)
/WRITEUP.md
__pycache__/
*.pyc
.DS_Store

# folder final/: yang masuk repo HANYA WRITEUP.md + img/
# (berkas soal mentah, solver, dan folder soal yang belum solved tetap lokal)
final/*
!final/*/
final/*/*
!final/*/WRITEUP.md
!final/*/img/
# Identitas-Utuh belum solved, digarap anggota lain. Folder sudah disiapkan
# lewat .gitkeep dan mengikuti aturan yang sama: cukup taruh WRITEUP.md +
# img/, lalu push. Tidak perlu mengubah berkas ini.
!final/*/.gitkeep
